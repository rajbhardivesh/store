---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string | string[];
  canonical?: string;
  type?: "website" | "product" | "article";
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://rdhrobotics.in";
const canonicalURL = Astro.props.canonical || new URL(Astro.url.pathname, siteUrl).toString();

const { 
  title, 
  description, 
  image, 
  keywords, 
  type = "website", 
  schema: pageSchema 
} = Astro.props;

const makeTitle = title
  ? title.includes("RDH Robotics") ? title : `${title} | RDH Robotics`
  : "RDH Robotics | Cyber Tools, Embedded Systems & IoT Solutions";

const makeDescription = description || 
  "RDH Robotics designs and manufactures purpose-built hardware for Cyber Tools, embedded systems, IoT & SCADA solutions, RF wireless security research (RF Hunter), and RP2040 HID automation (USB D-Byte) in India.";

const resolvedImageWithDomain = image
  ? new URL(image, siteUrl).toString()
  : new URL("/opengraph.png", siteUrl).toString();

const defaultKeywords = [
  "Cyber Tools",
  "Embedded Systems",
  "IoT Solutions",
  "Industrial SCADA",
  "RF Hunter",
  "USB D-Byte",
  "RP2040 Development Board",
  "ESP8266 Security Research",
  "Hardware Pentesting",
  "Web Flasher Tool",
  "Rajbhar Divesh",
  "RDH Robotics India"
];

const keywordsString = Array.isArray(keywords)
  ? keywords.join(", ")
  : keywords || defaultKeywords.join(", ");

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "RDH Robotics",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "image": `${siteUrl}/opengraph.png`,
  "description": "Indian manufacturer of cyber security research hardware, embedded systems development boards, and industrial IoT solutions.",
  "founder": {
    "@type": "Person",
    "name": "Rajbhar Divesh"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Support",
    "email": "rdhrobotics@hotmail.com"
  },
  "sameAs": [
    "https://github.com/rdhrobotics",
    "https://x.com/rdhrobotics",
    "https://instagram.com/rdhrobotics",
    "https://docs.rdhrobotics.in",
    "https://flasher.rdhrobotics.in"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "RDH Robotics",
  "description": "Hardware for Cyber Tools, Embedded Systems, IoT & SCADA Solutions",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google & Search Engine Directives -->
    <meta name="keywords" content={keywordsString} />
    <meta name="author" content="RDH Robotics" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#05070A" />
    <meta name="color-scheme" content="dark" />

    <!-- OpenGraph, Twitter & Canonical via astro-seo -->
    <SEO
      title={makeTitle}
      description={makeDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@rdhrobotics",
        site: "@rdhrobotics",
        card: "summary_large_image",
        title: makeTitle,
        description: makeDescription,
        image: resolvedImageWithDomain,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: type === "product" ? "website" : type,
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        optional: {
          siteName: "RDH Robotics",
          description: makeDescription,
          locale: "en_US",
        },
        image: {
          alt: makeTitle,
          width: 1200,
          height: 630,
        },
      }}
    />

    <!-- Structured Data (JSON-LD) for Search Engines & AI Crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {pageSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    )}
  </head>
  <body class="bg-[#05070A] text-slate-100 antialiased">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
