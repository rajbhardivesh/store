---
import { Image } from "astro:assets";
interface Props { name: string; href: string; image: ImageMetadata; text: string; price?: string; badges?: string[] }
const { name, href, image, text, price, badges = [] } = Astro.props;
---
<a href={href} class="product-card surface group block rounded-2xl p-3">
  <div class="relative overflow-hidden rounded-xl bg-[#080d12]">
    <Image src={image} alt={name} width={820} height={615} loading="lazy" class="aspect-[4/3] w-full object-contain transition duration-500 group-hover:scale-105" />
    <span class="mono absolute right-3 top-3 rounded-full border border-cyan-300/20 bg-[#071017]/90 px-3 py-1 text-[10px] uppercase tracking-wider text-cyan-200">RDH / 01</span>
  </div>
  <div class="p-3 pb-2">
    <div class="flex items-start justify-between gap-4"><h3 class="text-xl font-semibold tracking-tight text-slate-100">{name}</h3>{price && <span class="mono whitespace-nowrap text-xs text-cyan-300">{price}</span>}</div>
    <p class="mt-2 leading-6 text-slate-400">{text}</p>
    <div class="mt-4 flex flex-wrap gap-1.5">{badges.map((badge) => <span class="mono rounded border border-slate-700 px-2 py-1 text-[10px] tracking-wider text-slate-300">{badge}</span>)}</div>
  </div>
</a>
